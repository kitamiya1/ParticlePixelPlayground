{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Aquarium Explore",
  "mainBinaryName": "aquarium-explore",
  "version": "0.1.0",
  "identifier": "io.github.kitamiya1.aquariumexplore",
  "build": {
    "frontendDist": "../dist-app",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:app"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "水槽探検",
        "url": "aquarium.html",
        "width": 1280,
        "height": 800,
        "minWidth": 480,
        "minHeight": 360,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#12151f"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" }
    },
    "android": {
      "minSdkVersion": 24,
      "debugApplicationIdSuffix": ".debug"
    },
    "iOS": {
      "minimumSystemVersion": "15.0"
    }
  }
}
